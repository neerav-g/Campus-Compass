{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build project",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                
                // ➡️ CRITICAL FIX: Compile BOTH source files for linking
                // This assumes your files are located at: /workspaces/DSA_Project3/src/
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/CampusCompass.cpp", 
                
                "-o",
                // Output the executable into a dedicated 'bin' directory in the workspace root
                "${workspaceFolder}/bin/main" 
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "G++ build task for multi-file project in Codespaces."
        }
    ],
    "version": "2.0.0"
}